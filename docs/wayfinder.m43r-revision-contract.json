  "revisionThesis": "Replace three repeated inspect-choose-response acts with spatial route commitment, environmental evidence interpretation, and irreversible legacy commitment, connected by lived travel through three continuous regions.",
  "acts": [
    { "act": 1, "primitive": "spatial_route_commitment", "question": "How do I enter this journey?", "sequence": ["survey_landscape", "preview_route", "commit_route", "world_response", "two_beat_travel"] },
    { "act": 2, "primitive": "environmental_evidence_interpretation", "question": "What do I trust in the world my route produced?", "sequence": ["inspect_two_or_three_traces", "compare_incomplete_evidence", "act_on_interpretation", "world_response", "two_beat_transformed_travel"] },
