{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/reference-profile.schema.json",
  "title": "Single-reference derived profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "referenceId", "runId", "source", "rightsStatus", "rightsBasis", "sourceRightsNotes", "rightsCaveats", "claims", "insufficientEvidence"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "referenceId": { "type": "string", "pattern": "^ref_[a-f0-9]{20}$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "source": { "type": "object", "additionalProperties": false, "required": ["sanitizedUrl"], "properties": { "sanitizedUrl": { "type": "string", "format": "uri", "maxLength": 2048 } } },
    "rightsStatus": { "$ref": "#/definitions/rightsStatus" },
    "rightsBasis": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "sourceRightsNotes": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "rightsCaveats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/claim" } },
    "insufficientEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
  },
  "definitions": {
    "rightsStatus": { "enum": ["inspect_only", "reuse_allowed", "attribution_required", "licensed", "permission_required", "unknown", "blocked"] },
    "evidenceRef": { "type": "object", "additionalProperties": false, "required": ["runId", "evidenceId"], "properties": { "runId": { "type": "string", "pattern": "^[a-z0-9_-]+$" }, "evidenceId": { "type": "string", "pattern": "^ev_[a-z0-9_-]+$" } } },
    "confidence": { "type": "object", "additionalProperties": false, "required": ["level", "rationale"], "properties": { "level": { "enum": ["low", "medium", "high"] }, "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["id", "category", "statement", "epistemicType", "supportingEvidence", "contradictoryEvidence", "confidence", "limitations"], "properties": {
      "id": { "type": "string", "pattern": "^rpc_[a-z0-9_-]+$" },
      "category": { "enum": ["layout_structure", "visual_language", "typography", "color_system", "spacing_density", "interaction_pattern", "motion_pattern", "navigation", "content_structure", "narrative_progression", "media_usage", "responsive_behavior", "technical_signal"] },
      "statement": { "type": "string", "minLength": 1, "maxLength": 2000 }, "epistemicType": { "enum": ["inference", "evaluation"] },
      "supportingEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/evidenceRef" } },
      "contradictoryEvidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/evidenceRef" } },
      "confidence": { "$ref": "#/definitions/confidence" }, "limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
    } }
  }
}
