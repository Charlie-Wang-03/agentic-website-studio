{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/rights.schema.json",
  "title": "Rights assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["referenceId", "runId", "sourceReference", "status", "basis", "isLegalOpinion"],
  "properties": {
    "referenceId": { "type": "string", "pattern": "^ref_[a-f0-9]{20}$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "sourceReference": { "type": "string", "format": "uri", "maxLength": 2048 },
    "status": { "enum": ["inspect_only", "reuse_allowed", "attribution_required", "licensed", "permission_required", "unknown", "blocked"] },
    "basis": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "license": { "type": "string", "maxLength": 200 },
    "isLegalOpinion": { "const": false },
    "notes": { "type": "string", "maxLength": 1000 }
  }
}
