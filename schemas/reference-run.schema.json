{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/reference-run.schema.json",
  "title": "Reference research run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "project", "requestedUrl", "finalUrl", "capturedAt", "viewport", "tools", "artifacts", "evidenceIds", "warnings", "errors", "policyDecisions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "requestedUrl": { "type": "string", "format": "uri" },
    "finalUrl": { "type": "string", "format": "uri" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 320 }, "height": { "type": "integer", "minimum": 240 } } },
    "tools": { "type": "object", "additionalProperties": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/definitions/artifact" }, "minItems": 4 },
    "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "policyDecisions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "definitions": { "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\]+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
}
