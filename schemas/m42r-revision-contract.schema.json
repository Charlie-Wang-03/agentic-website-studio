{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/m42r-revision-contract.schema.json",
  "title": "M4.2R Revision Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revisionContractId", "projectId", "selectedConceptId", "revisionOf", "humanFeedback", "previousImplementation", "objectives", "interactionModel", "deterministicStateMachine", "branchWorldResponses", "continuityRequirements", "nonGoals", "qaRequirements"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "revisionContractId": { "const": "revision_contract_wayfinder_m42r_slice_02" },
    "projectId": { "const": "project_wayfinder" },
    "selectedConceptId": { "const": "concept_three_bearings" },
    "revisionOf": { "$ref": "#/definitions/binding" },
    "humanFeedback": { "$ref": "#/definitions/binding" },
    "previousImplementation": {
      "type": "object", "additionalProperties": false, "required": ["commit", "sourceManifest"],
      "properties": { "commit": { "const": "f24463762500eb8031718ae8b378d44ecefe59b6" }, "sourceManifest": { "$ref": "#/definitions/binding" } }
    },
    "objectives": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "acceptance"], "properties": { "id": { "enum": ["O1", "O2", "O3", "O4", "O5"] }, "name": { "type": "string" }, "acceptance": { "type": "string" } } }
    },
    "interactionModel": { "type": "array", "minItems": 8, "items": { "type": "string" } },
    "deterministicStateMachine": {
      "type": "object", "additionalProperties": false, "required": ["initialState", "states", "transitions", "terminalStates"],
      "properties": {
        "initialState": { "const": "arrival" },
        "states": { "type": "array", "minItems": 12, "items": { "type": "string" }, "uniqueItems": true },
        "transitions": { "type": "array", "minItems": 20, "items": { "$ref": "#/definitions/transition" } },
        "terminalStates": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "pattern": "^ending_(edge|wait|gap)$" }, "uniqueItems": true }
      }
    },
    "branchWorldResponses": {
      "type": "object", "additionalProperties": false, "required": ["edge", "wait", "gap"],
      "properties": { "edge": { "$ref": "#/definitions/branch" }, "wait": { "$ref": "#/definitions/branch" }, "gap": { "$ref": "#/definitions/branch" } }
    },
    "continuityRequirements": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "nonGoals": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "qaRequirements": {
      "type": "object", "additionalProperties": false,
      "required": ["feedbackValidation", "contractConformance", "preChoiceObservation", "deliberationPreview", "explicitCommit", "immediateWorldResponse", "branchContinuation", "continuousScene", "desktop", "mobile", "keyboard", "touch", "reducedMotion", "accessibility", "networkIsolation", "runtimeErrors", "deterministicReplay", "sourceProvenance"],
      "properties": {
        "feedbackValidation": { "const": true }, "contractConformance": { "const": true }, "preChoiceObservation": { "const": true },
        "deliberationPreview": { "const": true }, "explicitCommit": { "const": true }, "immediateWorldResponse": { "const": true },
        "branchContinuation": { "const": true }, "continuousScene": { "const": true }, "desktop": { "const": true }, "mobile": { "const": true },
        "keyboard": { "const": true }, "touch": { "const": true }, "reducedMotion": { "const": true }, "accessibility": { "const": true },
        "networkIsolation": { "const": true }, "runtimeErrors": { "const": true }, "deterministicReplay": { "const": true }, "sourceProvenance": { "const": true }
      }
    }
  },
  "definitions": {
    "binding": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "type": "string" }, "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "transition": { "type": "object", "additionalProperties": false, "required": ["from", "event", "to"], "properties": { "from": { "type": "string" }, "event": { "type": "string" }, "to": { "type": "string" } } },
    "branch": {
      "type": "object", "additionalProperties": false,
      "required": ["tradeoffPreview", "geometryState", "routeRelationship", "markerRelationship", "environmentalState", "continuationAction"],
      "properties": { "tradeoffPreview": { "type": "string" }, "geometryState": { "type": "string" }, "routeRelationship": { "type": "string" }, "markerRelationship": { "type": "string" }, "environmentalState": { "type": "string" }, "continuationAction": { "type": "string" } }
    }
  }
}
