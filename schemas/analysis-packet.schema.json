{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/analysis-packet.schema.json",
  "title": "Bounded evidence-only analysis packet",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "packetId", "preparedAt", "reference", "runId", "sourceArtifacts", "observations", "rights", "screenshotArtifacts", "warnings", "missingEvidence", "analysisPolicy"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "packetId": { "type": "string", "pattern": "^ap_[a-f0-9]{20}$" }, "preparedAt": { "type": "string", "format": "date-time" },
    "reference": { "type": "object", "additionalProperties": false, "required": ["referenceId", "sanitizedUrl"], "properties": { "referenceId": { "type": "string", "pattern": "^ref_[a-f0-9]{20}$" }, "sanitizedUrl": { "type": "string", "format": "uri", "maxLength": 2048 } } },
    "runId": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "sourceArtifacts": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/definitions/artifact" } },
    "observations": { "type": "array", "minItems": 1, "items": { "$ref": "https://agentic-website-studio.local/schemas/evidence.schema.json" } },
    "rights": { "type": "array", "minItems": 1, "items": { "$ref": "https://agentic-website-studio.local/schemas/rights.schema.json" } },
    "screenshotArtifacts": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/definitions/artifact" } },
    "warnings": { "type": "array", "maxItems": 500, "items": { "type": "string", "maxLength": 2500 } }, "missingEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 1000 } },
    "analysisPolicy": { "type": "object", "additionalProperties": false, "required": ["evidenceOnly", "doNotBrowseSource", "doNotSearchClones", "doNotCopySourceText", "doNotReconstructCode", "rightsAreNotReusePermission", "enforcement"], "properties": {
      "evidenceOnly": { "const": true }, "doNotBrowseSource": { "const": true }, "doNotSearchClones": { "const": true }, "doNotCopySourceText": { "const": true }, "doNotReconstructCode": { "const": true }, "rightsAreNotReusePermission": { "const": true }, "enforcement": { "const": "protocol" }
    } }
  },
  "definitions": { "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\]+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
}
