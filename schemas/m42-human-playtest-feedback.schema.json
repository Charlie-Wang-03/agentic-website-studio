{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/m42-human-playtest-feedback.schema.json",
  "title": "M4.2 Human Playtest Feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "feedbackId", "projectId", "selectedConceptId", "action", "recordedAt", "timestampBasis", "previousBindings", "dimensions", "derivedRevisionHypotheses", "automationDidNotApprove", "provenanceStatement"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "feedbackId": { "const": "feedback_wayfinder_m42_playtest_01" },
    "projectId": { "const": "project_wayfinder" },
    "selectedConceptId": { "const": "concept_three_bearings" },
    "action": { "const": "request_revision" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "timestampBasis": { "const": "recorded_at_human_attestation" },
    "previousBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["implementationCommit", "humanPlaytestGate", "sourceManifest", "qaReport"],
      "properties": {
        "implementationCommit": { "const": "f24463762500eb8031718ae8b378d44ecefe59b6" },
        "humanPlaytestGate": { "$ref": "#/definitions/binding" },
        "sourceManifest": { "$ref": "#/definitions/binding" },
        "qaReport": { "$ref": "#/definitions/binding" }
      }
    },
    "dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["choiceClarity", "consequencePerceptibility", "feltAgency", "pacing", "visualCoherence", "narrativeTone", "narrowScreenMobileUsability"],
      "properties": {
        "choiceClarity": { "$ref": "#/definitions/failObservation" },
        "consequencePerceptibility": { "$ref": "#/definitions/failObservation" },
        "feltAgency": { "$ref": "#/definitions/failObservation" },
        "pacing": { "allOf": [{ "$ref": "#/definitions/observation" }, { "type": "object", "properties": { "result": { "const": "fail_too_fast" } } }] },
        "visualCoherence": { "$ref": "#/definitions/failObservation" },
        "narrativeTone": { "$ref": "#/definitions/notEvaluated" },
        "narrowScreenMobileUsability": { "$ref": "#/definitions/notEvaluated" }
      }
    },
    "derivedRevisionHypotheses": {
      "type": "array", "minItems": 4, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "epistemicType", "statement", "derivedFromDimensions"],
        "properties": {
          "id": { "type": "string", "pattern": "^H[1-9][0-9]*$" },
          "epistemicType": { "const": "inference" },
          "statement": { "type": "string", "minLength": 1 },
          "derivedFromDimensions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "automationDidNotApprove": { "const": true },
    "provenanceStatement": { "const": "Human requested revision. Automation did not approve or reject the implementation." }
  },
  "definitions": {
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"],
      "properties": { "id": { "type": "string" }, "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["epistemicType", "result", "humanStatement", "normalizedMeaning"],
      "properties": { "epistemicType": { "const": "human_observation" }, "result": { "type": "string" }, "humanStatement": { "type": "string", "minLength": 1 }, "normalizedMeaning": { "type": "string", "minLength": 1 } }
    },
    "failObservation": { "allOf": [{ "$ref": "#/definitions/observation" }, { "type": "object", "properties": { "result": { "const": "fail" } } }] },
    "notEvaluated": {
      "type": "object", "additionalProperties": false, "required": ["epistemicType", "result"],
      "properties": { "epistemicType": { "const": "human_observation" }, "result": { "const": "not_evaluated" } }
    }
  }
}
