{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/m42-source-manifest.schema.json",
  "title": "M4.2 Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "projectId", "selectedConceptId", "humanDecision", "implementationContract", "sourceFiles", "creativeAssets", "dependencies", "buildArtifacts"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestId": { "const": "manifest_wayfinder_m42_slice_01" },
    "projectId": { "const": "project_wayfinder" },
    "selectedConceptId": { "const": "concept_three_bearings" },
    "humanDecision": { "$ref": "#/definitions/binding" },
    "implementationContract": { "$ref": "#/definitions/binding" },
    "sourceFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/file" } },
    "creativeAssets": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/definitions/file" }, { "type": "object", "required": ["provenanceClass", "rightsStatus"], "properties": { "provenanceClass": { "const": "project_native" }, "rightsStatus": { "const": "project_owned_original" } } }] } },
    "dependencies": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "version", "license", "role"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "license": { "type": "string" }, "role": { "enum": ["build_dev_only", "test_dev_only"] } } } },
    "buildArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/file" } }
  },
  "definitions": {
    "binding": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "type": "string" }, "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "pattern": "^[^\\\\]+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "provenanceClass": { "type": "string" }, "rightsStatus": { "type": "string" } } }
  }
}
