  "$schema":"http://json-schema.org/draft-07/schema#","$id":"https://agentic-website-studio.local/schemas/reference-set.schema.json","title":"Validated M3 Reference Set","type":"object","additionalProperties":false,"required":["schemaVersion","projectId","minimumReferenceCount","references"],
