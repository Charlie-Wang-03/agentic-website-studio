{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/human-replaytest-gate.schema.json",
  "title": "M4.2R Human Re-Playtest Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateId", "projectId", "selectedConceptId", "status", "bindings", "preview", "revisionSummary", "automatedQaEstablished", "knownWarnings", "humanEvaluation", "availableHumanActions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "gateId": { "const": "replaytest_gate_wayfinder_m42r_slice_02" }, "projectId": { "const": "project_wayfinder" }, "selectedConceptId": { "const": "concept_three_bearings" }, "status": { "const": "pending_human_replaytest" },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["humanFeedbackSha256", "revisionContractSha256", "sourceManifestSha256", "qaReportSha256", "independentAuditSha256", "buildArtifacts"],
      "properties": { "humanFeedbackSha256": { "$ref": "#/definitions/sha" }, "revisionContractSha256": { "$ref": "#/definitions/sha" }, "sourceManifestSha256": { "$ref": "#/definitions/sha" }, "qaReportSha256": { "$ref": "#/definitions/sha" }, "independentAuditSha256": { "$ref": "#/definitions/sha" }, "buildArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/file" } } }
    },
    "preview": { "type": "object", "additionalProperties": false, "required": ["command", "address", "termination"], "properties": { "command": { "const": "npm run wayfinder:preview" }, "address": { "const": "http://127.0.0.1:4173" }, "termination": { "type": "string" } } },
    "revisionSummary": { "type": "string", "minLength": 1 }, "automatedQaEstablished": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "knownWarnings": { "type": "array", "items": { "type": "string" } },
    "humanEvaluation": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "object", "additionalProperties": false, "required": ["dimension", "question", "previousResult"], "properties": { "dimension": { "type": "string" }, "question": { "type": "string" }, "previousResult": { "enum": ["fail", "fail_too_fast", "not_evaluated", "request_revision"] } } } },
    "availableHumanActions": { "type": "array", "const": ["approve_for_expansion", "request_revision", "reject_implementation_direction"] }
  },
  "definitions": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "$ref": "#/definitions/sha" } } }
  }
}
