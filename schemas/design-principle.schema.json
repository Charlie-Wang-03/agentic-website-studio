{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/design-principle.schema.json",
  "title": "Transferable design principle (future stage)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "principle", "mechanism", "problemAddressed", "transferability", "constraints", "antiCopyNotes", "supportingEvidenceIds", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^dp_[a-z0-9_-]+$" },
    "principle": { "type": "string", "minLength": 1 },
    "mechanism": { "type": "string", "minLength": 1 },
    "problemAddressed": { "type": "string", "minLength": 1 },
    "transferability": { "enum": ["low", "medium", "high"] },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "antiCopyNotes": { "type": "string", "minLength": 1 },
    "supportingEvidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^ev_" }, "minItems": 1, "uniqueItems": true },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
