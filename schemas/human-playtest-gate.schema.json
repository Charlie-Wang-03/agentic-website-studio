{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/human-playtest-gate.schema.json",
  "title": "Human Playtest Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateId", "projectId", "selectedConceptId", "status", "bindings", "preview", "sliceDescription", "automatedQaEstablished", "knownWarnings", "humanOnlyQuestions", "availableHumanActions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "gateId": { "const": "playtest_gate_wayfinder_m42_slice_01" },
    "projectId": { "const": "project_wayfinder" },
    "selectedConceptId": { "const": "concept_three_bearings" },
    "status": { "const": "pending_human_playtest" },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["humanDecisionId", "implementationContractId", "sourceManifestSha256", "qaReportSha256", "buildArtifacts"],
      "properties": {
        "humanDecisionId": { "type": "string" },
        "implementationContractId": { "type": "string" },
        "sourceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "qaReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "buildArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/file" } }
      }
    },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "address", "termination"],
      "properties": {
        "command": { "const": "npm run wayfinder:preview" },
        "address": { "const": "http://127.0.0.1:4173" },
        "termination": { "type": "string" }
      }
    },
    "sliceDescription": { "type": "string" },
    "automatedQaEstablished": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "knownWarnings": { "type": "array", "items": { "type": "string" } },
    "humanOnlyQuestions": {
      "type": "array", "minItems": 6, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["dimension", "question"],
        "properties": { "dimension": { "type": "string" }, "question": { "type": "string" } }
      }
    },
    "availableHumanActions": { "type": "array", "const": ["approve_for_expansion", "request_revision", "reject_implementation_direction"] }
  },
  "definitions": {
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    }
  }
}
