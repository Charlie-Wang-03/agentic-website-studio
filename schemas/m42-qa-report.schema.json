{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-website-studio.local/schemas/m42-qa-report.schema.json",
  "title": "M4.2 Automated QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "projectId", "selectedConceptId", "humanDecisionId", "implementationContractId", "sourceManifestSha256", "overallResult", "categories", "warnings", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reportId": { "const": "qa_wayfinder_m42_slice_01" },
    "projectId": { "const": "project_wayfinder" },
    "selectedConceptId": { "const": "concept_three_bearings" },
    "humanDecisionId": { "type": "string" },
    "implementationContractId": { "type": "string" },
    "sourceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "overallResult": { "$ref": "#/definitions/result" },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "stateMachineUnitTests", "contractConformance", "desktopE2E", "mobileE2E", "keyboard", "touch", "reducedMotion", "accessibilityAutomatedScan", "externalNetworkTest", "consoleRuntimeErrors", "deterministicReplay", "assetProvenance", "independentImplementationAudit"],
      "properties": {
        "build": { "$ref": "#/definitions/category" },
        "stateMachineUnitTests": { "$ref": "#/definitions/category" },
        "contractConformance": { "$ref": "#/definitions/category" },
        "desktopE2E": { "$ref": "#/definitions/category" },
        "mobileE2E": { "$ref": "#/definitions/category" },
        "keyboard": { "$ref": "#/definitions/category" },
        "touch": { "$ref": "#/definitions/category" },
        "reducedMotion": { "$ref": "#/definitions/category" },
        "accessibilityAutomatedScan": { "$ref": "#/definitions/category" },
        "externalNetworkTest": { "$ref": "#/definitions/category" },
        "consoleRuntimeErrors": { "$ref": "#/definitions/category" },
        "deterministicReplay": { "$ref": "#/definitions/category" },
        "assetProvenance": { "$ref": "#/definitions/category" },
        "independentImplementationAudit": { "$ref": "#/definitions/category" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "definitions": {
    "result": { "enum": ["pass", "pass_with_warnings", "fail"] },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidence"],
      "properties": {
        "result": { "$ref": "#/definitions/result" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
