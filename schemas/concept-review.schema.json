  "$schema":"http://json-schema.org/draft-07/schema#","$id":"https://agentic-website-studio.local/schemas/concept-review.schema.json","title":"Independent M3 concept review","type":"object","additionalProperties":false,"required":["schemaVersion","reviewId","reviewType","projectId","synthesisId","conceptsSha256","verdict","findings","warnings","isLegalReview"],
